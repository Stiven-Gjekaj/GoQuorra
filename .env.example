# Copy to .env and change what you need. .env is not committed.

# ---------------------------------------------------------------------------
# The server
# ---------------------------------------------------------------------------

QUORRA_HTTP_ADDR=:8080
QUORRA_GRPC_ADDR=:50051

# debug, info, warn or error. Anything else is refused at startup.
QUORRA_LOG_LEVEL=info

# postgres or memory. memory keeps nothing when the process stops, and the
# server says so at startup.
QUORRA_STORE=postgres
DATABASE_URL=postgres://quorra:quorra@localhost:5432/quorra?sslmode=disable

# Required. There is no default, and the server refuses to start without it.
#
# Generate one rather than typing one:
#   openssl rand -hex 32
#
# The version of this file before the rebuild suggested
# "dev-api-key-change-in-production", and that string was also in the README
# and in the compose stack, so every deployment that followed the quick start
# was reachable by anybody who had read it.
QUORRA_API_KEY=

# ---------------------------------------------------------------------------
# Retries
# ---------------------------------------------------------------------------

# Retries after the first attempt, so 3 means a job runs four times. A job may
# name its own number when it is submitted.
QUORRA_MAX_RETRIES=3

# The wait before the first retry, doubling to the cap. Half of each wait is
# jitter, so a burst of failures does not all come back at the same instant.
QUORRA_RETRY_BASE=2s
QUORRA_RETRY_MAX=1h

# ---------------------------------------------------------------------------
# Background work
# ---------------------------------------------------------------------------

# How often to look for leases that ran out, and how many to take back at
# once. This is what makes a crashed worker survivable.
QUORRA_RECLAIM_EVERY=10s
QUORRA_RECLAIM_BATCH=100

# How often to refresh the queue length gauge. The metric lags by up to this.
QUORRA_STATS_EVERY=15s

# ---------------------------------------------------------------------------
# Keeping and removing finished jobs
# ---------------------------------------------------------------------------

# How long to keep a job in each finished state. Empty or 0 keeps it for ever,
# and that is the default for all three.
#
# The default is deliberate. A queue holds the only record that a piece of
# work happened, and a default that removed it would take that record from
# every deployment that upgraded without reading the notes.
#
# They are separate because the jobs are not alike. A succeeded job is noise
# after a week. A dead one is evidence, and the deployment that wants the
# first gone usually wants the second kept.
QUORRA_RETAIN_SUCCEEDED=
QUORRA_RETAIN_DEAD=
QUORRA_RETAIN_CANCELLED=

# How often the sweep runs, and how many jobs it removes per status per run.
# One bounded batch per tick, so a first sweep over a year of history cannot
# hold a database connection for as long as it takes.
QUORRA_RETENTION_EVERY=1h
QUORRA_RETENTION_BATCH=1000

QUORRA_SHUTDOWN_GRACE=15s
QUORRA_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# The worker
# ---------------------------------------------------------------------------

QUORRA_WORKER_ID=worker-1
QUORRA_WORKER_QUEUES=default
QUORRA_WORKER_MAX_JOBS=5

# Make this longer than the slowest handler. A job still running when its
# lease ends is given to another worker, and the work happens twice. The
# worker refuses to start if the shutdown wait is longer than the lease.
# Make this longer than the slowest handler, or let the worker hold it: a
# running job asks for the lease to be pushed out three times per lease, so a
# handler slower than its lease is no longer taken away mid-flight. The lease
# still matters, because it is how long a genuinely dead worker holds a job.
QUORRA_WORKER_LEASE_TTL=30s
QUORRA_WORKER_POLL_EVERY=1s
